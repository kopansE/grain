# ---------------------------------------------------------------------------
# Grain Orbit - environment variables
#
# Every key here is OPTIONAL. The app is designed so that keys are entered by
# the user in Settings (stored in the browser, never in the source code).
# These env values are only server-side FALLBACKS used by the two tiny API
# functions (api/ai.ts and api/hubspot.ts) when a request arrives without a
# user-supplied key. Set them on Vercel if you want evaluators / teammates to
# get live AI and HubSpot without pasting keys themselves.
#
# Copy this file to .env.local for local development.
# ---------------------------------------------------------------------------

# Anthropic API key (console.anthropic.com). Powers voice-to-lead, card scan,
# relationship-arc summaries, follow-up drafts and conference discovery.
ANTHROPIC_API_KEY=

# Default Claude model for AI features (the user can override in Settings).
# claude-opus-5 gives the best judgment; claude-sonnet-5 or claude-haiku-4-5 are faster.
ANTHROPIC_MODEL=claude-opus-5

# HubSpot Private App access token (Settings > Integrations > Private Apps).
# Needs contact read/write scopes; exact scopes documented in the README.
HUBSPOT_ACCESS_TOKEN=
